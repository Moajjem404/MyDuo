<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/animated_gradient"
    android:padding="24dp">

    <!-- Scrollable container for forms -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tv_setup_footer"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Heart Icon and Title -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/app_logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                app:strokeColor="@color/romantic_pink"
                app:strokeWidth="2dp"
                android:scaleType="centerCrop"
                android:contentDescription="App Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MyDuo Setup"
                android:textSize="28sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stay Connected Forever ❤️"
                android:textSize="14sp"
                android:textColor="@color/gray_light"
                android:layout_marginTop="4dp" />

            <!-- Watch Tutorial Card -->
            <LinearLayout
                android:id="@+id/card_watch_tutorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card"
                android:backgroundTint="#26FF4081"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_ui_tutorial"
                    android:contentDescription="Tutorial Video Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Watch Setup Tutorial"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap here to watch video guide 🎬"
                        android:textColor="@color/romantic_light_pink"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➔"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mode Selector Switcher Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/glass_card"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- Mode 1: Create New Connection -->
                <Button
                    android:id="@+id/btn_tab_create"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="➕ New Connection"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/romantic_pink"
                    app:cornerRadius="20dp" />

                <!-- Mode 2: Connect with Partner Code -->
                <Button
                    android:id="@+id/btn_tab_join"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🔗 Partner Code"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/gray_light"
                    android:backgroundTint="@color/glass_card_bg_dark"
                    app:cornerRadius="20dp" />

            </LinearLayout>

            <!-- PANEL 1: Create New Connection (Manual Entry) -->
            <LinearLayout
                android:id="@+id/panel_create_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card_pink_border"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="visible">

                <!-- 1. Telegram Bot Token Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telegram Bot Token"
                    android:textColor="@color/font_primary_pink"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_bot_token"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:hint="123456789:ABCdefGhIJKlmNoPQRsT"
                    android:textColorHint="@color/gray_dark"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/glass_card"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <!-- 2. Chat ID Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Telegram Chat / Group ID"
                    android:textColor="@color/font_primary_pink"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_group_id"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. -100123456789 or 12345678"
                    android:textColorHint="@color/gray_dark"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/glass_card"
                    android:inputType="text"
                    android:singleLine="true" />

                <!-- 3. Your Name Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Your Name"
                    android:textColor="@color/font_primary_pink"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_my_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Moajjem"
                    android:textColorHint="@color/gray_dark"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/glass_card"
                    android:inputType="textPersonName"
                    android:singleLine="true" />

                <!-- 4. Partner Display Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Partner Name"
                    android:textColor="@color/font_primary_pink"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_partner_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Mun / Honey"
                    android:textColorHint="@color/gray_dark"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/glass_card"
                    android:inputType="textPersonName"
                    android:singleLine="true" />

                <!-- 5. Your Gender Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Your Gender"
                    android:textColor="@color/font_primary_pink"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_male"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Male ♂"
                        android:textColor="@color/white"
                        android:buttonTint="@color/stroke_pink_glow"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rb_female"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Female ♀"
                        android:textColor="@color/white"
                        android:buttonTint="@color/stroke_pink_glow" />
                </RadioGroup>

                <!-- Dynamic Generated Sender ID Display -->
                <TextView
                    android:id="@+id/tv_generated_sender_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Sender ID: Moajjem"
                    android:textColor="@color/font_secondary_gold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:background="@drawable/glass_card_gold_border" />

            </LinearLayout>

            <!-- PANEL 2: Connect with Partner Code -->
            <LinearLayout
                android:id="@+id/panel_join_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card_purple_border"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <!-- Partner Code Title & Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste Partner Connection Code"
                    android:textColor="@color/font_primary_pink"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/et_partner_code"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="Paste MYDUO_... code"
                        android:textColorHint="@color/gray_dark"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/glass_card"
                        android:inputType="text"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btn_paste_code"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginStart="8dp"
                        android:text="Paste"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/romantic_pink"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Code Status Badge -->
                <TextView
                    android:id="@+id/tv_code_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Enter or paste the connection code sent by your partner."
                    android:textColor="@color/gray_light"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:padding="8dp"
                    android:background="@drawable/glass_card" />

                <!-- Your Name Input for Join Mode -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Your Name (Optional)"
                    android:textColor="@color/font_primary_pink"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_join_my_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Mun / Moajjem"
                    android:textColorHint="@color/gray_dark"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/glass_card"
                    android:inputType="textPersonName"
                    android:singleLine="true" />

                <!-- Dynamic Generated Sender ID Display for Join Mode -->
                <TextView
                    android:id="@+id/tv_join_generated_sender_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Sender ID: Partner"
                    android:textColor="@color/font_secondary_gold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:background="@drawable/glass_card_gold_border" />

            </LinearLayout>

            <!-- Help Link -->
            <TextView
                android:id="@+id/tv_setup_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Need Help? View Setup Guide"
                android:textColor="@color/romantic_light_pink"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

            <!-- Action Button & Loader -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save &amp; Connect"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    android:backgroundTint="@color/romantic_pink" />

                <ProgressBar
                    android:id="@+id/pb_loader"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    android:indeterminateTint="@color/white" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer Credit -->
    <LinearLayout
        android:id="@+id/tv_setup_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|center_horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="#FF4081"
            android:alpha="0.8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💗"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tv_setup_footer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💗"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="#FF4081"
            android:alpha="0.8" />

    </LinearLayout>

</RelativeLayout>
